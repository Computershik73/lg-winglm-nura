"""winglm-call-volume: volume keys during calls (LG Wing).

Call audio runs in the DSP voice path, not through PulseAudio, so the volume
keys (which change the PulseAudio sink volume) did nothing in a call. While
the sound card is in a "Voice Call" profile, the default sink's volume
drives:
  - earpiece/headset: the codec's digital gain (RX_RX0/RX_RX1), back to
    0 dB after the call (needs linux-lg-winglm r7+: older kernels refuse
    these controls above -44 dB, the writes then simply fail);
  - speakerphone: the amplifier gain, through the winglm-spk-gain service
    (FIFO /run/winglm-spk-gain), back to 100 % otherwise.
"""
import math
import os
import re
import subprocess
import sys
import time

CONTROLS = ('RX_RX0 Digital Volume', 'RX_RX1 Digital Volume')
ZERO_DB = 84        # raw value of 0 dB: the controls go from -84 to +40 dB
MAX_DB = 6          # at 100 %
MIN_DB = -40        # at the bottom of the scale (not muted)
SPK_FIFO = '/run/winglm-spk-gain'
EVENT = re.compile(r"on (sink|card) #|on server$")


def log(msg):
    print('winglm-call-volume: ' + msg, file=sys.stderr, flush=True)


def pactl(*args):
    r = subprocess.run(('pactl',) + args, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ''


def active_profile():
    """e.g. 'voice call (mic, speaker)'"""
    for line in pactl('list', 'cards').splitlines():
        line = line.strip().lower()
        if line.startswith('active profile:'):
            return line.split(':', 1)[1].strip()
    return ''


def sink_percent():
    out = pactl('get-sink-volume', '@DEFAULT_SINK@')
    vals = [int(v) for v in re.findall(r'(\d+)%', out)]
    if not vals:
        return None
    if 'yes' in pactl('get-sink-mute', '@DEFAULT_SINK@'):
        return 0
    return sum(vals) / len(vals)


def gain(pct):
    """PulseAudio's cubic volume curve, shifted so that 100 % is MAX_DB"""
    if pct <= 0:
        db = MIN_DB
    else:
        db = MAX_DB + 60 * math.log10(min(pct, 100) / 100)
    return ZERO_DB + max(MIN_DB, min(MAX_DB, round(db)))


def speaker(pct):
    """tell winglm-spk-gain; it also uses every message to check that the
    amplifier is back at full gain outside calls"""
    try:
        fd = os.open(SPK_FIFO, os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return
    try:
        os.write(fd, b'%d\n' % round(min(max(pct, 0), 100)))
    except OSError:
        pass
    finally:
        os.close(fd)


class Volume:
    def __init__(self):
        self.value = None
        self.spk = None

    def set(self, value):
        if value == self.value:
            return
        ok = True
        for c in CONTROLS:
            r = subprocess.run(('amixer', '-q', '-c', '0', 'cset', 'name=' + c, str(value)),
                               capture_output=True, text=True)
            if r.returncode:
                ok = False
                log('%s = %d refused: %s' % (c, value, r.stderr.strip()))
        if ok:
            log('earpiece/headset gain %+d dB' % (value - ZERO_DB))
        # don't retry a refused value on every event
        self.value = value

    def update(self):
        prof = active_profile()
        in_call = prof.startswith('voice call') or 'voicecall' in prof
        on_speaker = in_call and 'speaker' in prof
        pct = sink_percent() if in_call else None
        if in_call and not on_speaker and pct is not None:
            self.set(gain(pct))
        elif self.value is not None and self.value != ZERO_DB:
            self.set(ZERO_DB)
        spk = pct if on_speaker and pct is not None else 100
        if spk != self.spk:
            log('speakerphone volume %d %%' % spk)
            self.spk = spk
        speaker(spk)


def main():
    vol = Volume()
    while True:
        vol.update()
        p = subprocess.Popen(('pactl', 'subscribe'), stdout=subprocess.PIPE, text=True)
        for line in p.stdout:
            # sinks, cards and the default sink; not the busy sink inputs
            if EVENT.search(line):
                vol.update()
        p.wait()
        # PulseAudio went away (restart): try again shortly
        time.sleep(2)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
