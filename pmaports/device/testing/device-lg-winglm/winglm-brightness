#!/usr/bin/python3
# LG Wing: brightness of the two panels.
#
# Phosh only drives one backlight (the main panel, panel0-backlight). This
# program keeps the swivel panel (panel1-backlight) in step with it, or lets
# the user give the swivel panel a brightness of its own.
#
#   winglm-brightness --daemon   session service (XDG autostart): follows
#                                panel0 and applies the settings to panel1
#   winglm-brightness            settings window
#
# Settings (GSettings org.postmarketos.winglm.brightness):
#   sync        TRUE: the Phosh slider sets both panels
#   secondary   relative brightness of the swivel panel when not in sync
#
# Brightness is written through logind (Session.SetBrightness), the same way
# Phosh does it, so no extra permissions are needed.

import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

SCHEMA = "org.postmarketos.winglm.brightness"
APP_ID = "org.postmarketos.WinglmBrightness"
MAIN = "panel0-backlight"
SWIVEL = "panel1-backlight"
SYSFS = "/sys/class/backlight/%s/%s"
MIN_RAW = 1  # 0 switches the OLED backlight off completely


def read_int(dev, attr):
    try:
        with open(SYSFS % (dev, attr)) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def get_relative(dev):
    cur, top = read_int(dev, "brightness"), read_int(dev, "max_brightness")
    if cur is None or not top:
        return None
    return cur / top


class Backlights:
    """Write brightness through logind, like Phosh does."""

    def __init__(self):
        self.session = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
            "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
            "org.freedesktop.login1.Session", None)

    def set_raw(self, dev, raw):
        top = read_int(dev, "max_brightness")
        if not top:
            return
        raw = max(MIN_RAW, min(top, int(round(raw))))
        if read_int(dev, "brightness") == raw:
            return
        try:
            self.session.call_sync("SetBrightness",
                                   GLib.Variant("(ssu)", ("backlight", dev, raw)),
                                   Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error as e:
            # EPROTO: the panel is off. The kernel keeps the value and the
            # driver applies it when the panel is switched on again.
            if "EPROTO" not in e.message:
                print("SetBrightness %s=%d failed: %s" % (dev, raw, e.message), file=sys.stderr)

    def set_relative(self, dev, rel):
        top = read_int(dev, "max_brightness")
        if top:
            self.set_raw(dev, rel * top)


def settings():
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup(SCHEMA, True) is None:
        sys.exit("GSettings schema %s is not installed" % SCHEMA)
    return Gio.Settings.new(SCHEMA)


# --------------------------------------------------------------------------
# session service

class Daemon:
    POLL_MS = 1000  # fallback in case a write does not raise an inotify event

    def __init__(self):
        self.settings = settings()
        self.bl = Backlights()
        self.last_main = None
        path = SYSFS % (MAIN, "brightness")
        self.monitor = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *a: self.follow_main())
        self.settings.connect("changed", lambda *a: self.apply(force=True))
        GLib.timeout_add(self.POLL_MS, self.poll)
        self.apply(force=True)

    def follow_main(self):
        raw = read_int(MAIN, "brightness")
        if raw is None or raw == self.last_main:
            return
        self.last_main = raw
        if self.settings.get_boolean("sync"):
            self.bl.set_raw(SWIVEL, raw * read_int(SWIVEL, "max_brightness")
                            / read_int(MAIN, "max_brightness"))

    def apply(self, force=False):
        if self.settings.get_boolean("sync"):
            self.last_main = None
            self.follow_main()
        else:
            self.bl.set_relative(SWIVEL, self.settings.get_double("secondary"))

    def poll(self):
        self.follow_main()
        return GLib.SOURCE_CONTINUE

    def run(self):
        GLib.MainLoop().run()


# --------------------------------------------------------------------------
# settings window

def run_window():
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gtk

    class Window(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Яркость экранов")
            self.set_default_size(360, 420)
            self.settings = settings()
            self.bl = Backlights()
            self.updating = False

            page = Adw.PreferencesPage()
            group = Adw.PreferencesGroup(
                title="Яркость экранов",
                description="Большой экран регулируется ползунком в шторке Phosh.")
            page.add(group)

            self.sync_row = Adw.SwitchRow(
                title="Общая яркость",
                subtitle="Ползунок в шторке меняет яркость обоих экранов")
            self.sync_row.set_active(self.settings.get_boolean("sync"))
            self.sync_row.connect("notify::active", self.on_sync_toggled)
            group.add(self.sync_row)

            _, self.main_scale = self.scale_row(group, "Большой экран")
            self.swivel_row, self.swivel_scale = self.scale_row(group, "Малый экран")
            self.main_scale.connect("value-changed", self.on_main_changed)
            self.swivel_scale.connect("value-changed", self.on_swivel_changed)
            self.settings.connect("changed", lambda *a: self.refresh())

            toolbar = Adw.ToolbarView()
            toolbar.add_top_bar(Adw.HeaderBar())
            toolbar.set_content(page)
            self.set_content(toolbar)
            self.refresh()
            GLib.timeout_add(500, self.refresh_values)

        def scale_row(self, group, title):
            row = Adw.ActionRow(title=title)
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.01, 1.0, 0.01)
            scale.set_draw_value(False)
            scale.set_hexpand(True)
            scale.set_size_request(160, -1)
            row.add_suffix(scale)
            group.add(row)
            return row, scale

        def on_sync_toggled(self, row, _pspec):
            sync = row.get_active()
            if sync == self.settings.get_boolean("sync"):
                return
            if not sync:
                # start the separate slider from what the panel shows now
                rel = get_relative(SWIVEL)
                if rel is not None:
                    self.settings.set_double("secondary", rel)
            self.settings.set_boolean("sync", sync)

        def refresh(self):
            sync = self.settings.get_boolean("sync")
            if self.sync_row.get_active() != sync:
                self.sync_row.set_active(sync)
            self.swivel_row.set_sensitive(not sync)
            self.refresh_values()

        def refresh_values(self):
            self.updating = True
            for scale, dev in ((self.main_scale, MAIN), (self.swivel_scale, SWIVEL)):
                rel = get_relative(dev)
                if rel is not None and abs(scale.get_value() - rel) > 0.005:
                    scale.set_value(rel)
            self.updating = False
            return GLib.SOURCE_CONTINUE

        def on_main_changed(self, scale):
            if not self.updating:
                self.bl.set_relative(MAIN, scale.get_value())  # the service follows

        def on_swivel_changed(self, scale):
            if self.updating or self.settings.get_boolean("sync"):
                return
            self.settings.set_double("secondary", scale.get_value())

    app = Adw.Application(application_id=APP_ID)
    app.connect("activate", lambda a: Window(a).present())
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    if "--daemon" in sys.argv[1:]:
        Daemon().run()
    else:
        sys.exit(run_window())
