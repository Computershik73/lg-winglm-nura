build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# GPU (KGSL) and ION access for the video group
	install -Dm644 "$srcdir"/90-winglm-gpu.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-winglm-gpu.rules

	# each touchscreen belongs to its own panel
	install -Dm644 "$srcdir"/90-winglm-touch.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-winglm-touch.rules

	# power key must not shut down; no suspend on this kernel yet
	install -Dm644 "$srcdir"/50-winglm-logind.conf \
		"$pkgdir"/etc/elogind/logind.conf.d/50-winglm.conf
	install -Dm644 "$srcdir"/50-winglm-sleep.conf \
		"$pkgdir"/etc/elogind/sleep.conf.d/50-winglm.conf

	# the swivel sensor is a SW_LID switch, but not a lid: GNOME Settings
	# treated "closed" as "no usable display" (empty Displays page, crash)
	install -Dm644 "$srcdir"/90-winglm-upower.conf \
		"$pkgdir"/etc/UPower/UPower.conf.d/90-winglm.conf

	# polkitd as its own user (pidfd lookups), started before NM/MM
	install -Dm644 "$srcdir"/polkit.confd "$pkgdir"/etc/conf.d/polkit

	# this kernel rejects the 0.0.0.0 gateway NetworkManager puts on prefix
	# routes: add the Wi-Fi prefix and default routes with iproute2
	install -Dm755 "$srcdir"/50-winglm-routes.nm-dispatcher \
		"$pkgdir"/etc/NetworkManager/dispatcher.d/50-winglm-routes

	# keep NetworkManager away from the USB network interface
	install -Dm644 "$srcdir"/50-winglm-usb0.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/50-winglm-usb0.conf

	# recover DSI panels after an SDE frame timeout ("panel dead")
	install -Dm755 "$srcdir"/winglm-panel-recovery \
		"$pkgdir"/usr/bin/winglm-panel-recovery
	install -Dm755 "$srcdir"/winglm-panel-recovery.initd \
		"$pkgdir"/etc/init.d/winglm-panel-recovery
}

phosh_helpers() {
	pkgdesc="LG Wing: Phosh session helpers (screens follow the swivel, swivel screen brightness)"
	depends="$pkgname calls py3-gobject3 gtk4.0 libadwaita libgudev wlr-randr alsa-utils pulseaudio-utils"
	install_if="$pkgname=$pkgver-r$pkgrel phosh"
	replaces="$pkgname-brightness"

	# screens follow the swivel: main landscape in the T position, swivel
	# screen off while closed
	install -Dm755 "$srcdir"/winglm-swivel \
		"$subpkgdir"/usr/bin/winglm-swivel
	install -Dm644 "$srcdir"/org.postmarketos.winglm.swivel.gschema.xml \
		"$subpkgdir"/usr/share/glib-2.0/schemas/org.postmarketos.winglm.swivel.gschema.xml
	install -Dm644 "$srcdir"/winglm-swivel.desktop \
		"$subpkgdir"/etc/xdg/autostart/winglm-swivel.desktop
	# the phrog greeter session reads its own autostart dir
	install -Dm644 "$srcdir"/winglm-swivel.desktop \
		"$subpkgdir"/etc/phrog/autostart/winglm-swivel.desktop
	# PulseAudio left over from an earlier session: restart it on this
	# session's bus (otherwise only "Dummy Output")
	install -Dm755 "$srcdir"/winglm-pulse-session \
		"$subpkgdir"/usr/libexec/winglm-pulse-session
	install -Dm644 "$srcdir"/winglm-pulse-session.desktop \
		"$subpkgdir"/etc/xdg/autostart/winglm-pulse-session.desktop
	# volume keys during calls: the sink volume drives the codec's gain of
	# the earpiece/headset (the call audio itself bypasses PulseAudio)
	install -Dm755 "$srcdir"/winglm-call-volume \
		"$subpkgdir"/usr/libexec/winglm-call-volume
	install -Dm644 "$srcdir"/winglm-call-volume.desktop \
		"$subpkgdir"/etc/xdg/autostart/winglm-call-volume.desktop
	# the swivel decides the orientation: no forced portrait lock screen
	install -Dm644 "$srcdir"/90_winglm-phosh.gschema.override \
		"$subpkgdir"/usr/share/glib-2.0/schemas/90_winglm-phosh.gschema.override
	# Calls (patched): dial pad on the swivel screen while it is on
	install -Dm644 "$srcdir"/90_winglm-calls.gschema.override \
		"$subpkgdir"/usr/share/glib-2.0/schemas/90_winglm-calls.gschema.override

	# swivel screen brightness: follows the shell slider or has its own
	install -Dm755 "$srcdir"/winglm-brightness \
		"$subpkgdir"/usr/bin/winglm-brightness
	install -Dm644 "$srcdir"/winglm-brightness-daemon.desktop \
		"$subpkgdir"/etc/xdg/autostart/winglm-brightness-daemon.desktop
	install -Dm644 "$srcdir"/org.postmarketos.WinglmBrightness.desktop \
		"$subpkgdir"/usr/share/applications/org.postmarketos.WinglmBrightness.desktop
	install -Dm644 "$srcdir"/org.postmarketos.winglm.brightness.gschema.xml \
		"$subpkgdir"/usr/share/glib-2.0/schemas/org.postmarketos.winglm.brightness.gschema.xml
}

dsp() {
	pkgdesc="LG Wing: audio DSP, modem, calls, Wi-Fi and Bluetooth bring-up (downstream kernel)"
	depends="
		$pkgname
		bluez
		callaudiod
		make-dynpart-mappings
		msm-firmware-loader
		pd-mapper
		py3-gobject3
		python3
		qrtr-ns
		rmtfs
		tqftpserv
		"
	install_if="$pkgname=$pkgver-r$pkgrel"

	# firmware fixups, EFS file copies for rmtfs (partitions only read)
	install -Dm755 "$srcdir"/winglm-dsp-setup \
		"$subpkgdir"/usr/libexec/winglm-dsp-setup
	# WLAN board data to the firmware (cnss-daemon's job on Android)
	install -Dm755 "$srcdir"/winglm-wlfw-bdf \
		"$subpkgdir"/usr/bin/winglm-wlfw-bdf
	# WCN3991 Bluetooth patch/NVM over the UART, then hci_uart H4 (the
	# vendor Bluetooth HAL's job on Android; needs linux-lg-winglm >= r5)
	install -Dm755 "$srcdir"/winglm-bt "$subpkgdir"/usr/bin/winglm-bt
	# LG SIM lock: VSS init request so the USIM becomes ready (an LG RIL
	# helper's job on Android)
	install -Dm755 "$srcdir"/winglm-vss "$subpkgdir"/usr/bin/winglm-vss
	# calls: DSP voice session while ModemManager has a call (instead of
	# q6voiced, which gives up before the call route is set: no ringback)
	install -Dm755 "$srcdir"/winglm-voice "$subpkgdir"/usr/bin/winglm-voice
	for s in winglm-adsp winglm-rmtfs winglm-modem winglm-wlan winglm-bt winglm-vss winglm-voice; do
		install -Dm755 "$srcdir"/$s.initd "$subpkgdir"/etc/init.d/$s
	done
	# modem data port for ModemManager, rmtfs shared memory
	install -Dm644 "$srcdir"/90-winglm-modem.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/90-winglm-modem.rules
	# PulseAudio: interrupt driven scheduling for the Q6 PCMs (real time
	# playback/capture with 20-25 ms periods instead of 0.5 s)
	install -Dm644 "$srcdir"/91-winglm-pulse.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/91-winglm-pulse.rules
	# ALSA UCM for the sound card (routes from LG's mixer_paths.xml)
	local ucm="$subpkgdir"/usr/share/alsa/ucm2/conf.d/lito-mtp-snd-ca
	install -Dm644 "$srcdir"/lito-mtp-snd-card.conf "$ucm"/lito-mtp-snd-card.conf
	install -Dm644 "$srcdir"/HiFi.conf "$ucm"/HiFi.conf
	install -Dm644 "$srcdir"/VoiceCall.conf "$ucm"/VoiceCall.conf
	ln -s lito-mtp-snd-card.conf "$ucm"/lito-mtp-snd-ca.conf
}

volte() {
	pkgdesc="LG Wing: VoLTE (IMS client and SIP gateway for GNOME Calls)"
	depends="
		$pkgname-dsp
		calls
		glib
		gst-plugins-bad
		gst-plugins-base
		gst-plugins-good
		gst-plugins-ugly
		iproute2
		libsecret
		py3-gobject3
		py3-gst
		python3
		qmi-utils
		"
	install_if="$pkgname-dsp=$pkgver-r$pkgrel calls"

	# LG's modem firmware has no IMS client; this is it: IMS PDN over the
	# downstream IPA, ISIM AKA, IPsec, SIP registration; media in the modem
	# (LG MMPF engine, mmpf/modemmedia) or AMR(-WB) on the AP (media)
	local f
	for f in qmiqrtr ipadata uimtool sipmsg sdp media mmpf modemmedia imsreg2 volted; do
		install -Dm644 "$srcdir"/$f.py "$subpkgdir"/usr/lib/winglm-volte/$f.py
	done
	install -Dm755 "$srcdir"/winglm-volte.initd "$subpkgdir"/etc/init.d/winglm-volte
	# user session: GNOME Calls account for the local gateway
	install -Dm755 "$srcdir"/winglm-volte-calls \
		"$subpkgdir"/usr/libexec/winglm-volte-calls
	install -Dm644 "$srcdir"/winglm-volte-calls.desktop \
		"$subpkgdir"/etc/xdg/autostart/winglm-volte-calls.desktop
}

small_only() {
	pkgdesc="LG Wing: use only the small screen (boards without the main panel or the swivel)"
	depends="$pkgname"
	# DSI-1 forced off (needs linux-lg-winglm patch 0001), swivel pinned to
	# "opened" so the sub touch keeps its interrupt (patch 0002)
	install -Dm644 "$srcdir"/90-winglm-small-only.conf \
		"$subpkgdir"/usr/lib/kernel-cmdline.d/90-winglm-small-only.conf
}

