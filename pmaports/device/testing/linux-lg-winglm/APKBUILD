# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/vendor/lineageos_wing_defconfig
# plus the postmarketOS fragment in pmos.config (see tools/gen-config.sh)
pkgname=linux-lg-winglm
pkgver=4.19.325
pkgrel=6
pkgdesc="LG Wing kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="lg-winglm"
url="https://github.com/LineageOS/android_kernel_lge_sm7250"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	findutils
	flex
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	python3
	xz
"

# Full LLVM toolchain (ld.lld, llvm-ar, integrated assembler), the same way
# the Android build does it (build.config.common: LLVM=1)
export LLVM=1
export CC="clang"
export HOSTCC="clang"

_repository="android_kernel_lge_sm7250"
_commit="f16d8d7345901bb1933f25acedeb60c07cf0d2bb"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	0001-drm-msm-sde-switch-off-forced-off-splash-display.patch
	0002-input-gpio_keys-add-swivel_force.patch
	0003-drm-msm-dsi-panel-model-in-edid-name.patch
	0004-bluetooth-hci_h4-qualcomm-in-band-sleep.patch
	0005-asoc-ops-fix-bounds-check-for-sx-controls.patch
"

builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

_dtbs="vendor/qcom/lito-mtp.dtb vendor/qcom/lito-v2-mtp.dtb"

build() {
	unset LDFLAGS
	# Only the kernel and the two lito base dtbs: the board overlays come
	# from the stock dtbo partition, and the in-tree dtc rejects the LG
	# overlays (duplicate_label), so "make dtbs" is skipped on purpose.
	# Modules: hci_uart (H4) for the Bluetooth UART, see device-lg-winglm's
	# winglm-bt
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" \
		Image modules $_dtbs
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1 modules_install
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	local _dtb
	for _dtb in $_dtbs; do
		install -Dm644 "$builddir/$_outdir/arch/$_carch/boot/dts/$_dtb" \
			"$pkgdir/boot/dtbs/$_dtb"
	done

	# Header v2 boot.img takes a single dtb blob: ship both lito base
	# dtbs (v1 and v2 silicon) in one file, ABL selects by msm-id
	local _qcom="$pkgdir"/boot/dtbs/vendor/qcom
	cat "$_qcom"/lito-mtp.dtb "$_qcom"/lito-v2-mtp.dtb \
		> "$_qcom"/lito-winglm.dtb
}

