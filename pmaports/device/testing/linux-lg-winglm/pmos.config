# postmarketOS overrides applied on top of vendor/lineageos_wing_defconfig
CONFIG_LOCALVERSION="-lg-winglm"
# CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SYSVIPC=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UEVENT_HELPER=y
CONFIG_USER_NS=y
CONFIG_INPUT_EVDEV=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_AES=y
CONFIG_NLS_ASCII=y
CONFIG_VFAT_FS=y
CONFIG_SYN_COOKIES=y
CONFIG_CGROUPS=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
# boot log on the panel (msm fbdev + fbcon)
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# CONFIG_PFT is not set
# CONFIG_KINETO_GAN is not set
# CONFIG_USE_VFB is not set
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Unsigned modules
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
