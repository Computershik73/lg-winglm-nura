# QRTR name service daemon. Mainline kernels have it built in; downstream
# 4.19 kernels (LG Wing) don't, and the remote processors' services (audio,
# WLAN, modem, pd-mapper) can't find each other without it. The daemon was
# dropped from qrtr after 1.1, so only that is packaged from 1.1.
pkgname=qrtr-ns
pkgver=1.1
pkgrel=0
pkgdesc="Qualcomm IPC router name service (for downstream kernels)"
url="https://github.com/linux-msm/qrtr"
arch="aarch64 armv7"
license="BSD-3-Clause"
makedepends="meson"
subpackages="$pkgname-openrc"
source="qrtr-$pkgver.tar.gz::https://github.com/linux-msm/qrtr/archive/refs/tags/v$pkgver.tar.gz
	qrtr-ns.initd
	"
builddir="$srcdir/qrtr-$pkgver"
options="!check" # no tests

build() {
	abuild-meson -Dqrtr-ns=enabled -Dsystemd-service=disabled . output
	meson compile -C output
}

package() {
	install -Dm755 output/src/qrtr-ns "$pkgdir"/usr/bin/qrtr-ns
	install -Dm755 "$srcdir"/qrtr-ns.initd "$pkgdir"/etc/init.d/qrtr-ns
}
sha512sums="
