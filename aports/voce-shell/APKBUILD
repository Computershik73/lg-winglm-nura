caff20f70a7ae485ba798e4ca681a2b95778373619eec2afdea09be4b8748fd9b45567258cf89ede486ea4b9876afcc4bcf893568973e6ac8af191beffb1a668  voce-shell-session
2f9626d88965ab6b7a73965f93498fa13addd3faf7f0c387e199415f1e62fff2e6a83f535d8ac99ad0a6705107de701a0bccfc7759e473ceef8460cdc9a3beeb  voce.desktop
"
