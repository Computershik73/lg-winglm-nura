1a05b94160c42dc58724bc490ee5aa5d4b448aa17566865f813591ffe5420f43972ff20252061280a11bc4fad4f39ee93d484175b17c4d09ffe212d37c320ecf  voce-shell-session
2f9626d88965ab6b7a73965f93498fa13addd3faf7f0c387e199415f1e62fff2e6a83f535d8ac99ad0a6705107de701a0bccfc7759e473ceef8460cdc9a3beeb  voce.desktop
"
