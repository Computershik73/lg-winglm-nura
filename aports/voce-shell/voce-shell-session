#!/bin/sh
# LG Wing: session start script for the Voce shell (wayland-mobile-shell),
# started by greetd/phrog from /usr/share/wayland-sessions/voce.desktop.
#
# The shell is its own Wayland compositor (QtWaylandCompositor) and draws
# straight to KMS through Qt's eglfs platform. Only the swivel screen (DSI-2,
# 1080x1240) is used: the QWERTY prototype the shell is made for has only
# that screen. The main screen (DSI-1) and the msm_drm writeback connector
# (Virtual-1) are switched off.
#
# Settings for tests (environment, e.g. in ~/.config/voce-shell/env):
#   VOCE_OUTPUT        output to use (default DSI2; Qt names: DSI1, DSI2)
#   VOCE_SHELL         binary to run (default /usr/bin/wayland-mobile-shell)
#   WMS_UI_SCALE       size of the shell's interface (default 2.5 for the
#                      ~420 ppi swivel panel; apps are not affected)
#   WMS_AUTOSTART_SKIP autostart entries (ids, * allowed) the shell does not
#                      start; WMS_NO_AUTOSTART=1 starts none

[ -f "$HOME/.config/voce-shell/env" ] && . "$HOME/.config/voce-shell/env"

# Set before the session bus starts, so everything it activates sees them.
# ":GNOME" like Phosh (Phosh:GNOME): GNOME Settings and other GNOME apps
# refuse to run or drop features outside GNOME. xdg-desktop-portal reads
# its backends from voce-portals.conf.
unset WAYLAND_DISPLAY DISPLAY
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Voce:GNOME
export XDG_SESSION_DESKTOP=voce

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
	exec dbus-run-session -- "$0" "$@"
fi

LOGDIR="${XDG_CACHE_HOME:-$HOME/.cache}/voce-shell"
mkdir -p "$LOGDIR"
[ -f "$LOGDIR/session.log" ] && mv -f "$LOGDIR/session.log" "$LOGDIR/session.log.old"
exec >"$LOGDIR/session.log" 2>&1
echo "voce-shell-session: $(date)"

OUTPUT="${VOCE_OUTPUT:-DSI2}"
SHELL_BIN="${VOCE_SHELL:-/usr/bin/wayland-mobile-shell}"

# Touch controller of a panel, as /dev/input/eventN (Qt matches the node name)
touch_node() {
	for n in /sys/class/input/event*; do
		[ "$(cat "$n/device/name" 2>/dev/null)" = "$1" ] && { echo "/dev/input/${n##*/}"; return; }
	done
}
case "$OUTPUT" in
DSI1) TOUCH=$(touch_node touch_dev); BACKLIGHT=panel0-backlight ;;
*)    TOUCH=$(touch_node touch_sub_dev); BACKLIGHT=panel1-backlight ;;
esac

# eglfs_kms: one screen, everything else off. Qt names connectors without the
# dash (DSI1, DSI2, Virtual1, DP1).
KMS_CONFIG="${XDG_RUNTIME_DIR:-/tmp}/voce-shell-kms.json"
{
	echo '{ "device": "/dev/dri/card0", "hwcursor": false, "outputs": ['
	for o in DSI1 DSI2 Virtual1 DP1; do
		[ "$o" = "$OUTPUT" ] && continue
		echo "  { \"name\": \"$o\", \"mode\": \"off\" },"
	done
	echo "  { \"name\": \"$OUTPUT\", \"mode\": \"current\"${TOUCH:+, \"touchDevice\": \"$TOUCH\"} }"
	echo '] }'
} >"$KMS_CONFIG"
cat "$KMS_CONFIG"

export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
export QT_QPA_EGLFS_KMS_CONFIG="$KMS_CONFIG"
export QT_QPA_EGLFS_HIDECURSOR=1
# KGSL: no implicit fences, wait for the GPU before each page flip
export WMS_GL_FINISH=1
export WMS_BACKLIGHT_DIR="/sys/class/backlight/$BACKLIGHT"
# The swivel panel has ~420 ppi; the shell's pixel-sized screens (lock
# screen, cards, app grid, window list) were drawn for a 720x720 window
export WMS_UI_SCALE="${WMS_UI_SCALE:-2.5}"
# Apps see an output scale of 3, as under Phosh: 360x413 logical pixels, so
# GTK/libadwaita apps use their mobile layouts
export WMS_CLIENT_SCALE="${WMS_CLIENT_SCALE:-3}"
# The shell starts the session's services from XDG autostart, as
# gnome-session does for Phosh: PulseAudio, the keyring, GNOME Calls (it
# carries VoLTE calls through its SIP account), the port's call audio
# helpers. Left out: GNOME's settings daemons (they need Mutter/GNOME Shell
# interfaces the shell does not have; gsd-power would also blank and suspend
# behind its back), and the port's swivel and brightness daemons - the shell
# keeps the swivel screen on and owns its brightness itself.
export WMS_AUTOSTART_SKIP="${WMS_AUTOSTART_SKIP-org.gnome.SettingsDaemon.* winglm-swivel winglm-brightness-daemon}"
# Qt's libraries carry RUNPATH=$ORIGIN (/usr/lib), which musl searches before
# /etc/ld-musl-aarch64.path: without this Qt would load Alpine's EGL/GBM
# instead of the KGSL Mesa (mesa-kgsl) that phoc and the apps use.
[ -d /usr/lib/mesa-kgsl ] && export LD_LIBRARY_PATH="/usr/lib/mesa-kgsl${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$SHELL_BIN"
