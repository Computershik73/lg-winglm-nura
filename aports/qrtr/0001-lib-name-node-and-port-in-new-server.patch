From: winglm port
Subject: [PATCH] lib: name the node and port in NEW_SERVER

Downstream (CAF 4.19) kernels drop a NEW_SERVER control packet whose
server node isn't forwardable to the destination. With node 0 in the
packet that is the modem once it is up, so pd-mapper, tqftpserv and
rmtfs services registered after the modem booted never reached the name
service. Fill in the socket's own node and port (binding it first).
---
--- a/lib/qrtr.c	2026-11-16 04:50:26.083282846 +0400
+++ b/lib/qrtr.c	2026-11-16 04:50:26.112476312 +0400
@@ -102,11 +102,27 @@
 	if (qrtr_getname(sock, &sq))
 		return -1;
 
+	/* Get our port now: the announcement below carries it */
+	if (sq.sq_port == 0) {
+		sq.sq_family = AF_QIPCRTR;
+		if (bind(sock, (struct sockaddr *)&sq, sizeof(sq)) < 0 ||
+		    qrtr_getname(sock, &sq))
+			return -1;
+	}
+
 	memset(&pkt, 0, sizeof(pkt));
 
 	pkt.cmd = cpu_to_le32(QRTR_TYPE_NEW_SERVER);
 	pkt.server.service = cpu_to_le32(service);
 	pkt.server.instance = cpu_to_le32(instance << 8 | version);
+	/*
+	 * Name the server's node and port: downstream (CAF) kernels drop a
+	 * NEW_SERVER for "node 0" once a remote node 0 (the modem) exists
+	 * as not forwardable, so services registered after the modem came up
+	 * were never seen.
+	 */
+	pkt.server.node = cpu_to_le32(sq.sq_node);
+	pkt.server.port = cpu_to_le32(sq.sq_port);
 
 	return qrtr_sendto(sock, sq.sq_node, QRTR_PORT_CTRL, &pkt, sizeof(pkt));
 }
