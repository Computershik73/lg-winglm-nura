# Contributor: Bart Ribbers <bribbers@disroot.org>
# Contributor: Danct12 <danct12@disroot.org>
# Contributor: Newbyte <newbyte@disroot.org>
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/phosh <newbyte@postmarketos.org>"
pkgname=phosh
pkgver=0.58.0
# winglm fork of Alpine community/phosh: multi-panel fixes (0001),
# lockscreen keypad on the second screen when the main one is landscape (0002),
# a hotplugged monitor announced (and shielded) only once (0003), optional
# portrait lock screen (0004), move windows to the other screen (0005, needs
# phoc with phosh-private v9), app grid on the second screen (0006) and a
# home bar there for the overview swipe (0007), no dangling lockscreen when
# the compositor closes it (0008)
pkgrel=27
pkgdesc="Wayland shell for GNOME on mobile devices"
# armhf: blocked by gnome-shell-schemas
arch="all !armhf"
url="https://gitlab.gnome.org/World/Phosh/phosh"
license="GPL-3.0-only"
triggers="$pkgname.trigger=/usr/lib/phosh/plugins/prefs"
depends="
	$pkgname-schemas
	adwaita-fonts
	adwaita-icon-theme
	bash
	dbus-x11
	dbus:org.freedesktop.Secrets
	desktop-file-utils
	gnome-control-center
	gnome-session
	gnome-settings-daemon
	gnome-shell-schemas
	gsettings-desktop-schemas
	phoc
	phosh-keyboard
	polkit-elogind
	xwayland
	"
makedepends="
	appstream-dev
	callaudiod-dev
	elogind-dev
	evince-dev
	evolution-data-server-dev
	feedbackd-dev
	gcr-dev
	gettext-dev
	glib-dev
	gmobile-dev
	gnome-bluetooth-dev
	gnome-desktop-dev
	gtk+3.0-dev
	libadwaita-dev
	libgudev-dev
	libhandy1-dev
	libsecret-dev
	linux-pam-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-elogind-dev
	pulseaudio-dev
	py3-docutils
	qrcodegen-dev
	upower-dev
	wayland-dev
	wayland-protocols
	"
checkdepends="xvfb-run xmlstarlet"
options="!check"
# the ordering here is important - libphosh split functions need to run first to move the libphosh-0
# headers/pkgconfig/lib into the libphosh packages, before the top level -dev package gobbles
# up the rest.
subpackages="
	libphosh:libs
	libphosh-dev:libphosh_dev
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-portalsconf::noarch
	$pkgname-schemas::noarch
	$pkgname-systemd
	"
source="https://sources.phosh.mobi/releases/phosh/phosh-${pkgver/_/.}.tar.xz
	0001-multi-panel-lockscreen-bg-largest-builtin.patch
	0002-lockscreen-keypad-on-second-screen-in-landscape.patch
	0003-monitor-manager-announce-a-monitor-only-once.patch
	0004-rotation-manager-force-portrait-setting.patch
	0005-overview-move-windows-to-the-other-screen.patch
	0006-home-app-grid-on-second-screen.patch
	0007-home-bar-on-second-screen.patch
	0008-lockscreen-manager-forget-a-closed-lockscreen.patch
	"
builddir="$srcdir/$pkgname-${pkgver/_/.}"
somask="libphoshsearch.so"

prepare() {
	default_prepare
	sed -i 's/\.rc/_rc/' meson.build
}

build() {
	# phoc tests need a running Wayland compositor
	abuild-meson \
		-Db_lto=false \
		-Dphoc_tests=disabled \
		-Dtests=false \
		-Dman=true \
		-Dbindings-lib=true \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir/" meson install --no-rebuild --skip-subprojects -C output
}

portalsconf() {
	install_if="$pkgname=$pkgver-r$pkgrel xdg-desktop-portal>=1.17.1"
	amove usr/share/xdg-desktop-portal/phosh-portals.conf
}

libphosh_dev() {
	amove usr/include/libphosh-*
	amove usr/lib/libphosh-*.so
	amove usr/lib/pkgconfig/libphosh-*.pc
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=

	amove usr/share/glib-2.0/schemas
}

