From: winglm port
Subject: [PATCH] Fix multi-panel devices: lockscreen bg output, largest builtin

- layersurface: make wl-output a construct property. PhoshLockscreen creates
  its background in constructed() from its own wl-output, which was still
  NULL there, so the background went to the output phoc picked (the one
  under the cursor). With two outputs phoc then rejects stacking the
  lockscreen below it ("Layer surface not on same output") and the shell dies.
- shell: when several monitors are built in (LG Wing: main and swivel panel,
  both DSI), use the one with the largest physical size as builtin and
  primary monitor instead of the first one in the list.
---
--- a/src/layersurface.c	2026-11-15 23:47:30.130049405 +0400
+++ b/src/layersurface.c	2026-11-15 23:47:30.168286085 +0400
@@ -478,7 +478,7 @@
    */
   props[PROP_WL_OUTPUT] =
     g_param_spec_pointer ("wl-output", "", "",
-                          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS);
+                          G_PARAM_READWRITE | G_PARAM_CONSTRUCT | G_PARAM_STATIC_STRINGS);
   /**
    * PhoshLayerSurface:anchor:
    *
--- a/src/shell.c	2026-11-15 23:47:30.130564998 +0400
+++ b/src/shell.c	2026-11-15 23:47:30.168918382 +0400
@@ -1000,10 +1000,15 @@
 
   for (int i = 0; i < phosh_monitor_manager_get_num_monitors (priv->monitor_manager); i++) {
     PhoshMonitor *tmp = phosh_monitor_manager_get_monitor (priv->monitor_manager, i);
-    if (phosh_monitor_is_builtin (tmp) && tmp != old) {
+
+    if (!phosh_monitor_is_builtin (tmp) || tmp == old)
+      continue;
+
+    /* Devices with a second, smaller built-in panel: prefer the largest one */
+    if (monitor == NULL ||
+        (gint64) tmp->width_mm * tmp->height_mm >
+        (gint64) monitor->width_mm * monitor->height_mm)
       monitor = tmp;
-      break;
-    }
   }
 
   return monitor;
