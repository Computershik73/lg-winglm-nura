# Forked from Alpine community/callaudiod for the LG Wing: speaker switching
# with PulseAudio's one-profile-per-UCM-device and DSP voice mic mute (0001)
pkgname=callaudiod
pkgver=0.1.99
pkgrel=1
pkgdesc="Call audio routing daemon"
url="https://gitlab.com/mobian1/callaudiod"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	alsa-lib-dev
	appstream-dev
	glib-dev
	meson
	pulseaudio-dev
	"
subpackages="$pkgname-dev $pkgname-libs"
source="https://gitlab.com/mobian1/callaudiod/-/archive/$pkgver/callaudiod-$pkgver.tar.gz
	0001-pulse-profile-per-device-and-dsp-voice-mute.patch
	"
options="!check" # no tests

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

