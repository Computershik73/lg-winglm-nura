9f9d54f4ccb4fbed2328dfec9aada085667b4475e74256f964ac3469bddbbd8238e5daa3a1fc5c3d02fc77faa1fbe0c5f0d732d2f6840daa28e4b5d92806e1a2  0001-turnip-kgsl-do-not-fail-on-KHR_display.patch
6ec66541e1c5607a4bdb41472d84ef10279a89fe04c756a6a40734c1464807ab389814d5886f551ca38714a900334fc2aa20986f585bec0e3869aded2a6e47f4  ld-musl-aarch64.path
