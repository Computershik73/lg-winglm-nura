--- a/data/org.gnome.Calls.gschema.xml	2026-10-12 22:00:27.000000000 +0400
+++ b/data/org.gnome.Calls.gschema.xml	2026-11-21 08:09:54.668480846 +0400
@@ -33,5 +33,13 @@
       otherwise you must set the TLS transport.</description>
     </key>
 
+    <key name="dialpad-monitor" type="s">
+      <default>''</default>
+      <summary>Screen for a separate dial pad</summary>
+      <description>Connector name (for example DSI-2) of a second screen. While Calls is
+      in front and this screen is connected, the dial pad (and, during a call, the
+      DTMF keypad) is shown fullscreen on it and not in the main window. Empty: off.</description>
+    </key>
+
   </schema>
 </schemalist>
