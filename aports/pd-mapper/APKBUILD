# Protection domain mapper for Qualcomm remote processors. Mainline kernels
# have it built in, downstream ones (LG Wing, 4.19) need this daemon for the
# audio (ADSP) and WLAN (modem) protection domains.
pkgname=pd-mapper
pkgver=1.1
pkgrel=1
pkgdesc="Qualcomm protection domain mapper"
url="https://github.com/linux-msm/pd-mapper"
arch="aarch64 armv7"
license="BSD-3-Clause"
makedepends="qrtr-dev xz-dev"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/pd-mapper/archive/refs/tags/v$pkgver.tar.gz
	0001-find-jsons-without-remoteproc.patch
	pd-mapper.initd
	"
options="!check" # no tests

build() {
	make prefix=/usr
}

package() {
	install -Dm755 pd-mapper "$pkgdir"/usr/bin/pd-mapper
	install -Dm755 "$srcdir"/pd-mapper.initd "$pkgdir"/etc/init.d/pd-mapper
}
sha512sums="
