+        if (self->priv->ipa_downstream)
+            ctx->wda_ul_dap_requested = QMI_WDA_DATA_AGGREGATION_PROTOCOL_QMAP;
 
         if (first_iteration && setup_data_format_completed (task))
             return;
@@ -1767,6 +1980,26 @@
             return;
