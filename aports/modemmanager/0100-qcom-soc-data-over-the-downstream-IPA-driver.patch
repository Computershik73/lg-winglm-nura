From: winglm port
Subject: [PATCH] qcom-soc: data over the downstream (vendor kernel) IPA driver

Qualcomm SoCs running an Android vendor kernel (LG Wing, SM7250, 4.19)
expose the modem data port as rmnet_ipa0 of the downstream IPA driver: a
virtual netdev with no driver link, set up through the driver's extended
ioctls instead of sysfs. ModemManager refused it ("Unsupported QMI kernel
driver").

- kernel device: a udev rule may name the driver a driverless virtual
  netdev behaves like (ID_MM_KERNEL_DRIVER=ipa). Raw-IP links without
  lower_* sysfs links (rmnet on these kernels) get their parent from
  iflink, so they are grabbed as link ports.
- the QMAP uplink / QMAPv5 downlink split is allowed (an assert required
  the same aggregation protocol both ways).
- QMI port, with ID_MM_QCOM_IPA_DOWNSTREAM on the net port, as Android's
  netmgrd does: once per boot the IPA egress (QMAP, mux) and ingress
  (MAPv5 checksum, deaggregation, 31 datagrams / 31668 bytes) formats;
  the DPM port from the driver's WAN endpoint pair; WDA data format UL
  QMAP / DL QMAPv5 with the same aggregation limits; rmnet links with the
  MAPv5 ingress checksum; an IPA mux channel per link. Nothing is touched
  while probing, and not before 120 s of uptime (an early data path setup
  panicked this kernel).
---
diff -ruN a/src/kerneldevice/mm-kernel-device-helpers.c b/src/kerneldevice/mm-kernel-device-helpers.c
--- a/src/kerneldevice/mm-kernel-device-helpers.c	2026-10-05 08:10:41.000000000 +0400
+++ b/src/kerneldevice/mm-kernel-device-helpers.c	2026-11-21 11:24:27.013429832 +0400
@@ -14,6 +14,7 @@
  */
 
 #include <stdlib.h>
+#include <net/if.h>
 
 #include <glib.h>
 #include <glib-object.h>
@@ -60,6 +61,29 @@
         return g_path_get_basename (real_path);
     }
 
+    /* No lower_* link (rmnet links of some vendor kernels, e.g. with the
+     * downstream Qualcomm IPA driver): raw-IP links still give their
+     * parent's ifindex in iflink */
+    {
+        g_autofree gchar *type_path = g_build_filename (sysfs_path, "type", NULL);
+        g_autofree gchar *ifindex_path = g_build_filename (sysfs_path, "ifindex", NULL);
+        g_autofree gchar *iflink_path = g_build_filename (sysfs_path, "iflink", NULL);
+        g_autofree gchar *type = NULL;
+        g_autofree gchar *ifindex = NULL;
+        g_autofree gchar *iflink = NULL;
+        gchar             name[IF_NAMESIZE];
+        guint             parent;
+
+        if (g_file_get_contents (type_path, &type, NULL, NULL) &&
+            g_file_get_contents (ifindex_path, &ifindex, NULL, NULL) &&
+            g_file_get_contents (iflink_path, &iflink, NULL, NULL) &&
+            atoi (type) == 519 /* ARPHRD_RAWIP */ &&
+            (parent = (guint) atoi (iflink)) > 0 &&
+            parent != (guint) atoi (ifindex) &&
+            if_indextoname (parent, name))
+            return g_strdup (name);
+    }
+
     return NULL;
 }
 
diff -ruN a/src/kerneldevice/mm-kernel-device-udev.c b/src/kerneldevice/mm-kernel-device-udev.c
--- a/src/kerneldevice/mm-kernel-device-udev.c	2026-10-05 08:10:41.000000000 +0400
+++ b/src/kerneldevice/mm-kernel-device-udev.c	2026-11-21 11:24:27.012921859 +0400
@@ -339,9 +339,18 @@
 }
 
 static const gchar *
-kernel_device_get_driver (MMKernelDevice *self)
+kernel_device_get_driver (MMKernelDevice *_self)
 {
-    return MM_KERNEL_DEVICE_UDEV (self)->priv->driver;
+    MMKernelDeviceUdev *self;
+
+    self = MM_KERNEL_DEVICE_UDEV (_self);
+
+    /* Virtual network devices of out-of-tree drivers (e.g. rmnet_ipa0 of the
+     * downstream Qualcomm IPA driver) have no driver link; a udev rule may
+     * name the driver they behave like. */
+    if (!self->priv->driver && self->priv->device)
+        return g_udev_device_get_property (self->priv->device, "ID_MM_KERNEL_DRIVER");
+    return self->priv->driver;
 }
 
